# Where the contact form posts. Without it the form reports a failure instead
# of pretending the message was sent.
#
#   Hosted form service (e.g. Web3Forms):
#     VITE_CONTACT_ENDPOINT=https://api.web3forms.com/submit
#     VITE_CONTACT_ACCESS_KEY=your-access-key
#
#   Own endpoint: any URL that accepts a JSON POST of
#     { subject, name, email, message, botcheck }
#   and answers 2xx once the mail is on its way. No access key needed.
VITE_CONTACT_ENDPOINT=
VITE_CONTACT_ACCESS_KEY=
