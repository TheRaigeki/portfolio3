# ── Contact form ──────────────────────────────────────────────────────────
# The server sends over SMTP, so any provider works and switching one means
# changing these values, not the code. With Resend:
#
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxx      # a Resend API key
#
# Runtime variables — they stay on the server and must never be prefixed
# with VITE_, or they would be baked into the public bundle.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Envelope sender. Must sit on a domain verified with the provider.
CONTACT_FROM=formular@raigeki.dev
# Where the messages land.
CONTACT_TO=robin@raigeki.dev

# ── Optional ──────────────────────────────────────────────────────────────
# Build-time only. Defaults to the server's own /api/contact; set it to point
# the form somewhere else entirely.
# VITE_CONTACT_ENDPOINT=
